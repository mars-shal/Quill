# Copy to .env and fill in real values. NEVER commit .env.

# --- LLM provider (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Persona model split: reasoning personas (Nous/Oracle/Sage/Scout/Warden) use
# the thinking model; the Quill writer uses the writing model. Leave a slot
# empty to use LLM_MODEL / the provider registry's selected model for it.
QUILL_THINKING_MODEL=
QUILL_WRITING_MODEL=

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Rate limits ---
QUILL_TPM=6000
QUILL_RPM=30
# Daily token cap per model, shown as the usage bar's denominator in Settings.
# Groq's free (on_demand) tier is200k/day per model.
QUILL_TPD=200000
QUILL_RETRIES=5
# Every reservation books input estimate + this output allowance, because
# billed tokens include the model's answer (input-only booking under-reserves
# the 60s window by ~half; see the 2026-10-30 A/B notes). Set 0 to disable.
QUILL_OUTPUT_TOKENS=1200
# `cli` providers (opencode run, codex exec, ...) get this many seconds per
# turn before the subprocess is killed. Agentic CLIs can think for minutes on
# one prompt, so this is generous by design.
QUILL_CLI_TIMEOUT=600
# Hidden reasoning is billed as output on reasoning models (gpt-oss). `low`
# cut that ~7x in a live A/B (2026-10-30) -- the difference between a section
# run fitting the free tier's 8000 TPM and being rate-limited. Set empty ("")
# for the model default. Only ever applied to models that accept the knob.
QUILL_REASONING_EFFORT=low
# SearXNG metasearch (see docs/searxng.md). Empty URL disables research.
# Default is http://localhost:8080 when unset. Set empty ("") to disable SearXNG entirely.
# `bash gui/scripts/dev-sidecar.sh` runs its own instance and exports this itself,
# so leaving it empty here does not turn research off under that script.
QUILL_SEARXNG_URL=
QUILL_SEARXNG_CATEGORIES=general

# --- Writer -> researcher feedback loop (default ON) ---
# When a section comes back as an INSUFFICIENT EVIDENCE placeholder, run ONE
# extra research round aimed at the distinctive terms the corpus lacks, then
# re-write ONLY those sections. On by default because a placeholder is a
# wasted write; the research half costs no LLM calls (one re-write per target,
# each with the normal retry allowance). See artifacts/gap-research/cost-model.md.
# Set to 0 to disable the placeholder-repair round.
QUILL_GAP_RESEARCH=1
# Ceilings for that round. These LOWER the hard caps, never raise them.
# QUILL_GAP_RESEARCH_QUERIES=4   # searches issued (max 5)
# QUILL_GAP_RESEARCH_PAGES=10    # pages added to the corpus (max 12)
# QUILL_GAP_RESEARCH_SECTIONS=5  # sections re-written per round (max 8)
# QUILL_GAP_RESEARCH_ROUNDS=2    # batches of failed sections (max 3)

# --- PocketBase (Tauri app connects to this endpoint) ---
# Local development default. Production should be an HTTPS URL.
VITE_POCKETBASE_URL=http://127.0.0.1:8090
