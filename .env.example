# quill_engine environment template.
# Copy to .env (already gitignored) and fill in what you use.
# No key is required for fully-local runs (LLM_PROVIDERS=ollama).

# --- Provider API keys (all optional) ---
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
FIREWORKS_API_KEY=

# --- GUI: Google Fonts catalog (optional) ---
# Without a key the font picker offers only the locally bundled fonts.
GOOGLE_FONTS_KEY=

# --- Optional backends (leave empty for the default in-memory store) ---
OPEN_SEARCH_URL=
OPEN_SEARCH_USER=
OPEN_SEARCH_PASSWORD=
REDIS_URL=

# --- Customize behavior (examples; see README for the full list) ---
# LLM_PROVIDERS=ollama
# QUILL_STAGED=auto
# QUILL_PROFILE=auto
# QUILL_RESEARCH=1
# QUILL_SEARCH_CACHE_TTL_H=168
# QUILL_SEARCH_CONCURRENCY=3
# QUILL_PLAG_THRESHOLD=0.6
# QUILL_STORE=memory
# QUILL_OS_VERIFY_TLS=1
