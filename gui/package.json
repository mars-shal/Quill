    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "border-beam": "^1.4.1",
    "bot-avatars": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "katex": "^0.18.0",
    "lib0": "^0.2.118",
    "liquid-gooey": "^0.2.2",
    "lucide-react": "^1.52.0",
    "metal-fx": "^2.0.11",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
