{
  "name": "quill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Quill — a quiet, local-first writing workspace with an AI companion.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "bash scripts/tauri.sh",
    "tauri:dev": "bash scripts/tauri.sh dev",
    "tauri:build": "bash scripts/tauri.sh build",
    "tauri:build:fast": "bash scripts/tauri.sh build --no-bundle",
    "icon": "python3 scripts/make-icon.py && tauri icon src-tauri/icons/source.png",
    "test": "bash scripts/test-js.sh",
    "check:rust": "bash scripts/check-rust.sh",
    "check": "npm run check:contrast && npm run test && npm run check:rust",
    "verify": "node scripts/verify-persistence.mjs && node scripts/verify-legacy-import.mjs && node scripts/verify-export.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
